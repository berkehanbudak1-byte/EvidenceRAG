# Copy to .env and uncomment the values you want to change.
# Variables already set in the environment take precedence over this file.
# ACCESS_PROFILE=local  # Default: direct loopback only.
# ACCESS_PROFILE=hosted  # Also accepts alias cloud. Requires the secrets below.
# EVIDENCERAG_API_KEY=  # Required for hosted; send as X-API-Key on /ask and document mutations.
# EVIDENCERAG_PUBLIC_HOST=example.com,www.example.com  # Comma-separated Host allowlist for hosted.
# EVIDENCERAG_DEMO=false  # true|false|auto — auto enables sample answers when model packages are missing.

# EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
# EMBEDDING_QUERY_PREFIX="query: "
# EMBEDDING_PASSAGE_PREFIX="passage: "
# LLM_PROVIDER=local  # local (default) | xai (alias grok)
# LLM_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
# EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
# LLM_MODEL_REVISION=989aa7980e4cf806f80c7fef2b1adb7bc71aa306
# XAI_API_KEY=  # Required when LLM_PROVIDER=xai (GROK_API_KEY also accepted).
# XAI_MODEL_NAME=grok-3-mini  # Default xAI Grok model (GROK_MODEL_NAME also accepted).
# XAI_API_URL=https://api.x.ai/v1/chat/completions
# XAI_TIMEOUT_SECONDS=60
# INGESTION_VERSION=1
# CHUNKER_STRATEGY=markdown_v1
# Opt-in only: CHUNKER_STRATEGY=structured_v2 + INGESTION_VERSION=2
# Reindex original documents into a separate INDEX_DIR; never overwrite old indexes.
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100
# TOP_K=5
# RELEVANCE_THRESHOLD=0.80
# HYBRID_SEARCH=true
# RETRIEVAL_CANDIDATES=30
# KEYWORD_WEIGHT=0.5
# RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
# RERANKER_MODEL_REVISION=<40-character immutable model commit SHA>
# RERANK_CANDIDATES=20
# OCR_LANGUAGES=tr,en
# MAX_NEW_TOKENS=256
# MAX_UPLOAD_MB=20
# MAX_UPLOAD_BYTES=20971520  # Optional: overrides MAX_UPLOAD_MB (MiB).
# MAX_HTTP_BODY_BYTES=21037056
# MAX_JSON_BODY_BYTES=32768
# MAX_MULTIPART_HEADER_BYTES=8192
# MAX_FILENAME_BYTES=512
# MAX_QUESTION_CHARS=4000
# MAX_PDF_PAGES=500
# MAX_TEXT_CHARS=2000000
# MAX_DOCUMENT_CHUNKS=2000
# MAX_STORE_CHUNKS=20000
# MAX_STORE_TEXT_BYTES=67108864
# MAX_ACTIVE_HEAVY_JOBS=1
# MAX_WAITING_HEAVY_JOBS=2
# ASK_QUEUE_CAPACITY=2
# INDEX_QUEUE_CAPACITY=2
# MODEL_QUEUE_CAPACITY=2
# HEAVY_WAIT_SECONDS=30
# PRELOAD_MODELS=false
# TORCH_NUM_THREADS=4  # Optional; omit to preserve host thread defaults.
# INDEX_DIR=data/index
